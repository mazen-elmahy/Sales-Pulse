      "id": "0b744205-6854-4520-b7de-19e9c4057550",
      "name": "Get Products",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1984,
        352
      ],
      "alwaysOutputData": true,
      "credentials": {
        "supabaseOAuth2Api": {
          "id": "XSDstPdk7OqKNLbD",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $('Validate Input').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r && r.id !== undefined);\nconst byId = {};\nfor (const r of rows) byId[Number(r.id)] = r;\n\nconst problems = [];\nconst lines = [];\n\nfor (const it of input.items) {\n  const p = byId[it.product_id];\n  if (!p) { problems.push(`Product ${it.product_id} was not found.`); continue; }\n  if (!p.is_available || Number(p.stock_qty) <= 0) { problems.push(`${p.name} is not available right now.`); continue; }\n  if (Number(p.stock_qty) < it.quantity) { problems.push(`Only ${p.stock_qty} of ${p.name} left in stock (requested ${it.quantity}).`); continue; }\n  const price = Number(p.price);\n  lines.push({\n    product_id: it.product_id,\n    name: p.name,\n    quantity: it.quantity,\n    unit_price: price,\n    line_total: Math.round(price * it.quantity * 100) / 100,\n    stock_qty: Number(p.stock_qty)\n  });\n}\n\nreturn [{\n  json: {\n    ...input,\n    cart: lines,\n    ok: problems.length === 0,\n    status: problems.some(m => m.startsWith('Only')) ? 'out_of_stock' : 'unavailable',\n    message: problems.join(' ')\n  }\n}];"
      },
