        "jsCode": "const calc = $('Calculate Totals').first().json;\nconst orderId = $input.first().json.id;\n\nreturn calc.cart.map(l => ({\n  json: {\n    order_id: orderId,\n    product_id: l.product_id,\n    quantity: l.quantity,\n    unit_price: l.unit_price,\n    new_stock: l.stock_qty - l.quantity\n  }\n}));"
