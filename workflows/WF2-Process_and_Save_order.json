        "jsCode": "const cart = $('Build Cart').first().json;\nconst settings = $input.first().json || {};\nconst vipRate = Number(settings.vip_discount_percent ?? 0);\nconst vipThreshold = Number(settings.vip_threshold ?? 0);\n\nconst subtotal = Math.round(cart.cart.reduce((s, l) => s + l.line_total, 0) * 100) / 100;\nconst isVip = cart.is_vip === true;\nconst discountPercent = isVip ? vipRate : 0;\nconst discountAmount = Math.round(subtotal * discountPercent) / 100;\nconst total = Math.round((subtotal - discountAmount) * 100) / 100;\nconst newTotalSpent = Math.round((Number(cart.total_spent) + total) * 100) / 100;\nconst becomesVip = !isVip && vipThreshold > 0 && newTotalSpent >= vipThreshold;\n\nconst itemsText = cart.cart.map(l => `• ${l.quantity} x ${l.name} - ${l.line_total} EGP`).join('\\n');\n\nreturn [{\n  json: {\n    ...cart,\n    subtotal,\n    discount_percent: discountPercent,\n    discount_amount: discountAmount,\n    total,\n    discount_reason: isVip ? 'VIP customer' : 'none',\n    new_total_spent: newTotalSpent,\n    becomes_vip: becomesVip,\n    items_text: itemsText\n  }\n}];"
      },
      "id": "dff6f0a0-8e44-4af5-b53e-aed7958dabc5",
