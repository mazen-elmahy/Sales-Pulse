    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $json;\nlet items = d.items;\nif (typeof items === 'string') {\n  try { items = JSON.parse(items); } catch (e) { items = null; }\n}\n\nconst errors = [];\nconst merged = {};\n\nif (!Array.isArray(items) || items.length === 0) {\n  errors.push('The order has no items.');\n} else {\n  for (const it of items) {\n    const pid = Number(it && it.product_id);\n    const qty = Number(it && it.quantity);\n    if (!Number.isSafeInteger(pid) || pid <= 0) { errors.push('One of the items has an invalid product.'); continue; }\n    if (!Number.isSafeInteger(qty) || qty <= 0) { errors.push('Quantity must be a positive whole number for each item.'); continue; }\n    merged[pid] = (merged[pid] || 0) + qty;\n  }\n}\n\nconst cart = Object.entries(merged).map(([pid, qty]) => ({ product_id: Number(pid), quantity: qty }));\nif (cart.length > 20) errors.push('Too many different products in one order (max 20).');\n\nconst phone = String(d.phone || '').replace(/[\\s-]/g, '').replace(/^\\+?20/, '0');\nif (!/^01[0125][0-9]{8}$/.test(phone)) {\n  errors.push('The phone number must be a valid Egyptian mobile number, for example 01012345678.');\n}\n\nconst address = String(d.delivery_address || '').trim();\nif (address.length < 10) {\n  errors.push('The delivery address is too short. Please send the area, street and building or apartment.');\n}\n\nconst customerId = Number(d.customer_id);\nif (!Number.isSafeInteger(customerId) || customerId <= 0) {\n  errors.push('The customer could not be identified.');\n}\n\nreturn {\n  json: {\n    ...d,\n    customer_id: customerId,\n    items: cart,\n    phone,\n    delivery_address: address,\n    product_ids: cart.map(i => i.product_id).join(','),\n    ok: errors.length === 0,\n    status: 'invalid_input',\n    message: errors.join(' ')\n  }\n};"
      },
