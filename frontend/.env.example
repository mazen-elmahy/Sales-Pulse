# SalesPulse Dashboard Environment Configuration
# Note: Never commit private service-role keys or n8n credentials here!

# Supabase Project URL (found in Supabase Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public / Anon Key (Safe for frontend Auth)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# n8n Instance Base URL exposing the read-only webhooks
VITE_N8N_API_URL=https://your-n8n-instance.com
