# SalesPulse Environment Variables

# Frontend Dashboard
# Connect to your n8n webhook instance for live metrics
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/dashboard-metrics
VITE_DASHBOARD_API_KEY=salespulse-admin-secret-2026

# Supabase (Used by n8n backend only - NEVER expose service key in frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Telegram Bot (For customer ordering interface)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
